{
  "uid": "sluice-overview",
  "title": "Sluice — multi-cloud traffic router",
  "description": "Where traffic is going, what that costs, what it emits, and whether the SLO is holding. Every query targets a metric Sluice actually exports; see deploy/prometheus/alerts.yaml for the alerting rules on the same series.",
  "tags": [
    "sluice",
    "traffic-management",
    "finops",
    "sustainability"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sluice_route_requests_per_second, route)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cloud",
        "label": "Cloud",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(sluice_backend_traffic_share, cloud)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Policy reloads",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "iconColor": "purple",
        "expr": "changes(sluice_route_plan_generation[1m]) > 5",
        "titleFormat": "Distribution republished",
        "textFormat": "route {{route}}"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Fleet",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": [],
      "id": 1
    },
    {
      "type": "stat",
      "title": "Decision rate",
      "description": "Requests the router is authorising and placing, summed across routes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sluice_route_requests_per_second{route=~\"$route\"})",
          "legendFormat": "req/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "none",
        "textMode": "value"
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Allowed",
      "description": "Share of decisions that were authorised. A sustained drop means a policy change, not a capacity problem — check sluice_denials_total by reason.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sluice_decisions_total{verdict=\"allow\"}[5m])) / clamp_min(sum(rate(sluice_decisions_total[5m])), 0.001)",
          "legendFormat": "allowed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Net egress saved",
      "description": "Cost avoided minus cost added, against a latency-only balancer choosing under the same policy constraints. Negative is legitimate — it means the router is deliberately spending to hold an SLO or cut emissions, and it says so rather than netting it away.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(sluice_egress_cost_avoided_usd_total[30m])) - sum(rate(sluice_egress_cost_added_usd_total[30m]))) * 3600",
          "legendFormat": "USD/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "id": 4
    },
    {
      "type": "stat",
      "title": "Net carbon avoided",
      "description": "gCO2e per hour avoided against the same counterfactual. Derived from the configured energy-intensity assumption — see /api/status for the figure in force.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(sluice_carbon_avoided_grams_total[30m])) - sum(rate(sluice_carbon_added_grams_total[30m]))) * 3600",
          "legendFormat": "gCO2e/hr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      },
      "id": 5
    },
    {
      "type": "stat",
      "title": "Regions carrying traffic",
      "description": "Backends with a closed circuit breaker. A drop here is an upstream incident; the router has already shed them.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sluice_backend_circuit_state == 0)",
          "legendFormat": "healthy"
        },
        {
          "refId": "B",
          "expr": "count(sluice_backend_circuit_state)",
          "legendFormat": "total"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "none",
        "textMode": "value_and_name"
      },
      "id": 6
    },
    {
      "type": "stat",
      "title": "Routes over SLO",
      "description": "Routes whose projected blended p95 exceeds their target after the guardrail has already shed the slowest candidates. Non-zero means even the fastest remaining region is too slow — a capacity problem, not a routing one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(sluice_route_slo_met == 0) or vector(0)",
          "legendFormat": "breaching"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "none",
        "colorMode": "background"
      },
      "id": 7
    },
    {
      "type": "row",
      "title": "Where traffic is going",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": [],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Traffic share by cloud",
      "description": "Fraction of each route's traffic allocated per provider. Summing across routes, so with several routes selected the total exceeds 1 — pick one route to read it as a distribution.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cloud) (sluice_backend_traffic_share{route=~\"$route\", cloud=~\"$cloud\"})",
          "legendFormat": "{{cloud}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "aws"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#FF9E2C"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gcp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#6BA1F7"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "azure"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#35B8F5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Decisions by verdict",
      "description": "no_capacity is distinct from deny on purpose: the request was authorised and there was nowhere legal or healthy to send it. That should page someone; a deny should not.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (verdict) (rate(sluice_decisions_total{route=~\"$route\"}[1m]))",
          "legendFormat": "{{verdict}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "allow"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "deny"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "no_capacity"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10
    },
    {
      "type": "row",
      "title": "The trade being made",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "collapsed": false,
      "panels": [],
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "Egress cost against the baseline",
      "description": "Avoided and added are separate counters rather than one netted figure: a netted counter cannot be used with rate(), and it hides the trade. Added climbing while avoided stays flat means carbon or the SLO is being bought with money.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sluice_egress_cost_avoided_usd_total[10m])) * 3600",
          "legendFormat": "avoided"
        },
        {
          "refId": "B",
          "expr": "-sum(rate(sluice_egress_cost_added_usd_total[10m])) * 3600",
          "legendFormat": "added"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never",
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avoided"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "added"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 12
    },
    {
      "type": "timeseries",
      "title": "Emissions against the baseline",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Same shape as the cost panel. Sluice will pay more money for less carbon when a route's objectives say to, and both sides are visible here.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(sluice_carbon_avoided_grams_total[10m])) * 3600",
          "legendFormat": "avoided"
        },
        {
          "refId": "B",
          "expr": "-sum(rate(sluice_carbon_added_grams_total[10m])) * 3600",
          "legendFormat": "added"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "massg",
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "avoided"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#56E39F"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "added"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13
    },
    {
      "type": "timeseries",
      "title": "Latency paid for those savings",
      "description": "Extra p95 accepted per second of traffic, versus the latency-only choice. This is the cost side of every saving on the left — if it climbs without the savings climbing, the objectives are mistuned.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 15
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(sluice_latency_debt_seconds_total{route=~\"$route\"}[10m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14
    },
    {
      "type": "row",
      "title": "SLO and health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false,
      "panels": [],
      "id": 15
    },
    {
      "type": "timeseries",
      "title": "Projected p95 by route",
      "description": "The traffic-weighted p95 the current distribution is expected to deliver. An approximation of a mixture's true quantile — the plan also reports the pessimistic bound.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sluice_route_projected_p95_seconds{route=~\"$route\"}",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 16
    },
    {
      "type": "state-timeline",
      "title": "Circuit breaker state",
      "description": "0 closed, 1 half-open (a 5% recovery trickle), 2 open. Half-open flapping repeatedly is worse than open — the region keeps earning its way back and failing again; drain it explicitly.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sluice_backend_circuit_state{cloud=~\"$cloud\"}",
          "legendFormat": "{{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 80
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "closed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "half-open",
                  "color": "orange",
                  "index": 1
                },
                "2": {
                  "text": "open",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "mergeValues": true,
        "showValue": "never"
      },
      "id": 17
    },
    {
      "type": "timeseries",
      "title": "Plan churn",
      "description": "L1 distance between the newly computed distribution and the published one. Sustained values above ~0.35 mean the router is thrashing: raise router.smoothing or router.deadband, or find the signal oscillating underneath.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sluice_route_plan_churn{route=~\"$route\"}",
