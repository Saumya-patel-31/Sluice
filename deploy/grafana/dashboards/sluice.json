        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 27
    },
    {
      "type": "timeseries",
      "title": "Authorisation cache hit rate",
      "description": "Policy evaluation is the one part of the request path whose cost grows with operator input. Below 50% usually means a policy reads a unique per-request value, making every request a distinct cache key.",
